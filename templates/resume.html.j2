<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ name }} — Resume</title>
<style>
  /* One-column, ATS-friendly layout: real text, standard headings, no tables or images. */
  @page { size: Letter; margin: 0.5in 0.55in; }
  :root { --ink: #1a1a1a; --muted: #555; --rule: #999; }
  body { font-family: "Calibri", "Carlito", "Arial", sans-serif; font-size: 10.5pt; line-height: 1.28;
         color: var(--ink); background: #fff; margin: 0; }
  .page { max-width: 7.4in; margin: 0 auto; padding: 0.25in 0; }
  h1 { font-size: 18pt; margin: 0; text-align: center; letter-spacing: 0.3px; }
  .contact { text-align: center; color: var(--muted); margin: 2px 0 0; }
  .headline { text-align: center; font-weight: 600; margin: 4px 0 6px; }
  h2 { font-size: 10.5pt; text-transform: uppercase; letter-spacing: 0.8px; border-bottom: 1px solid var(--rule);
       margin: 9px 0 4px; padding-bottom: 1px; }
  .row { display: flex; justify-content: space-between; gap: 12px; }
  .entry { margin: 0 0 5px; break-inside: avoid; }
  .title { font-weight: 700; }
  .sub { font-style: italic; }
  .dates { white-space: nowrap; color: var(--muted); }
  ul { margin: 2px 0 0 0; padding-left: 16px; }
  li { margin: 0 0 1px; }
  .skills p { margin: 0 0 2px; }
  .summary { margin: 0; }
</style>
</head>
<body>
<div class="page">
  <h1>{{ name }}</h1>
  <p class="contact">{{ location }} &nbsp;|&nbsp; {{ email }} &nbsp;|&nbsp; {{ phone }}</p>
  {% if headline %}<p class="headline">{{ headline }}</p>{% endif %}

  {% if summary %}
  <h2>Summary</h2>
  <p class="summary">{{ summary }}</p>
  {% endif %}

  <h2>Skills</h2>
  <div class="skills">
    {% for g in skill_groups %}<p><strong>{{ g.label }}:</strong> {{ g.skills | join(", ") }}</p>{% endfor %}
  </div>

  <h2>Experience</h2>
  {% for e in experience %}
  <div class="entry">
    <div class="row"><span><span class="title">{{ e.title }}</span> — {{ e.company }}</span><span class="dates">{{ e.dates }}</span></div>
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}

  <h2>Projects</h2>
  {% for p in projects %}
  <div class="entry">
    <div><span class="title">{{ p.name }}</span> <span class="sub">— {{ p.tech }}</span></div>
    <ul>{% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}

  <h2>Education</h2>
  {% for ed in education %}
  <div class="entry">
    <div class="row"><span><span class="title">{{ ed.degree }}</span> — {{ ed.institution }}{% if ed.location %}, {{ ed.location }}{% endif %}</span><span class="dates">{{ ed.date }}</span></div>
    {% if ed.gpa or ed.coursework %}<div>{% if ed.gpa %}GPA: {{ ed.gpa }}{% endif %}{% if ed.gpa and ed.coursework %} &nbsp;|&nbsp; {% endif %}{% if ed.coursework %}Relevant coursework: {{ ed.coursework | join(", ") }}{% endif %}</div>{% endif %}
  </div>
  {% endfor %}
</div>
</body>
</html>
